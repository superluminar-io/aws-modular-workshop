{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "translate:TranslateText"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "translate:SourceLanguageCode": "en",
          "translate:TargetLanguageCode": "de"
        }
      }
    }
  ]
}